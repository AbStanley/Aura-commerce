# E-Commerce Platform Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# =====================
# Database
# =====================
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=ecommerce

# =====================
# JWT Configuration
# =====================
JWT_SECRET=your-jwt-secret-minimum-32-characters-here
JWT_ISSUER=UserService
JWT_AUDIENCE=ECommercePlatform

# =====================
# RabbitMQ
# =====================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your-rabbitmq-password-here

# =====================
# Seq Logging
# =====================
SEQ_ADMIN_PASSWORD=your-seq-password-here

# =====================
# Redis
# =====================
REDIS_PASSWORD=your-redis-password-here

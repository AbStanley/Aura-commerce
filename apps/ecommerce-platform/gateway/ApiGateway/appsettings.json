{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Authority": "http://localhost:5001"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "product-route": {
        "ClusterId": "product-service",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "category-route": {
        "ClusterId": "product-service",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-service",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "order-route": {
        "ClusterId": "order-service",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "payment-route": {
        "ClusterId": "payment-service",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "notification-route": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "user-docs-route": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/docs/users/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "product-docs-route": {
        "ClusterId": "product-service",
        "Match": {
          "Path": "/docs/products/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "cart-docs-route": {
        "ClusterId": "cart-service",
        "Match": {
          "Path": "/docs/cart/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "order-docs-route": {
        "ClusterId": "order-service",
        "Match": {
          "Path": "/docs/orders/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "payment-docs-route": {
        "ClusterId": "payment-service",
        "Match": {
          "Path": "/docs/payments/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "notification-docs-route": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/docs/notifications/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "product-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "cart-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "order-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "payment-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "notification-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
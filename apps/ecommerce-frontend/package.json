    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.2",
    "@ngrx/signals": "^21.0.1",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
